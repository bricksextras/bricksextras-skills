{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "bricksextras://elements/xtoast",
    "schemaVersion": "1.7.3",
    "type": "object",
    "title": "Toast",
    "description": "Schema for BricksExtras Toast element. A nestable element",
    "metadata": {
        "name": "xtoast",
        "category": "extras",
        "tag": "div",
        "nestable": true,
        "childElement": "xtoastnotification"
    },
    "settings": {
        "builderHidden": {
            "label": "Hide in builder",
            "valueSchema": {
                "type": "boolean"
            },
            "controlType": "checkbox"
        },
        "builderHidden_sep": {
            "valueSchema": {
                "type": "string"
            },
            "controlType": "separator"
        },
        "position": {
            "label": "Position",
            "default": "bottom-right",
            "options": {
                "top-left": "Top Left",
                "top-center": "Top Center",
                "top-right": "Top Right",
                "bottom-left": "Bottom Left",
                "bottom-center": "Bottom Center",
                "bottom-right": "Bottom Right"
            },
            "valueSchema": {
                "type": "string",
                "enum": [
                    "top-left",
                    "top-center",
                    "top-right",
                    "bottom-left",
                    "bottom-center",
                    "bottom-right"
                ]
            },
            "controlType": "select"
        },
        "visibleToasts": {
            "label": "Max. visible toasts",
            "placeholder": "3",
            "valueSchema": {
                "oneOf": [
                    {
                        "type": "string",
                        "description": "Value with unit (e.g., \"10px\", \"50%\")"
                    },
                    {
                        "type": "number"
                    }
                ]
            },
            "controlType": "number"
        },
        "gap": {
            "label": "Gap between stacked toasts (px)",
            "placeholder": "14",
            "valueSchema": {
                "oneOf": [
                    {
                        "type": "string",
                        "description": "Value with unit (e.g., \"10px\", \"50%\")"
                    },
                    {
                        "type": "number"
                    }
                ]
            },
            "controlType": "number"
        },
        "offset": {
            "label": "Offset from viewport (px)",
            "placeholder": "24",
            "valueSchema": {
                "oneOf": [
                    {
                        "type": "string",
                        "description": "Value with unit (e.g., \"10px\", \"50%\")"
                    },
                    {
                        "type": "number"
                    }
                ]
            },
            "controlType": "number"
        }
    },
    "rendering": {
        "description": "HTML structure and CSS classes used by this element",
        "rootElement": "div",
        "nestable": true,
        "childrenContainer": "Renders child elements within the structure"
    },
    "documentation": {
        "description": "* Toast element class.",
        "keywords": [
            "toast",
            "notification",
            "message",
            "alert"
        ],
        "usage": {
            "category": "extras",
            "nestable": true
        },
        "bestPractices": [
            "This is a nestable element - add child elements to build your content structure"
        ]
    }
}