{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "bricksextras://elements/xpagetourstep",
    "schemaVersion": "1.7.3",
    "type": "object",
    "title": "Page Tour Step",
    "description": "Schema for BricksExtras Page Tour Step element. A nestable element",
    "metadata": {
        "name": "xpagetourstep",
        "category": "extras",
        "tag": "div",
        "nestable": true,
        "childElement": "text-basic"
    },
    "settings": {
        "stepTitle": {
            "label": "Title",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "stepSelector": {
            "label": "Element (Selector)",
            "placeholder": ".your-target-element",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "stepPosition": {
            "label": "Preferred placement",
            "placeholder": "Auto",
            "options": {
                "auto": "Auto",
                "top": "Top",
                "bottom": "Bottom",
                "left": "Left",
                "right": "Right",
                "top-start": "Top Start",
                "top-end": "Top End",
                "bottom-start": "Bottom Start",
                "bottom-end": "Bottom End",
                "left-start": "Left Start",
                "left-end": "Left End",
                "right-start": "Right Start",
                "right-end": "Right End"
            },
            "valueSchema": {
                "type": "string",
                "enum": [
                    "auto",
                    "top",
                    "bottom",
                    "left",
                    "right",
                    "top-start",
                    "top-end",
                    "bottom-start",
                    "bottom-end",
                    "left-start",
                    "left-end",
                    "right-start",
                    "right-end"
                ]
            },
            "controlType": "select"
        },
        "stepId": {
            "label": "Step ID",
            "description": "User-friendly ID for hash link navigation (e.g., link to #advanced-step)",
            "placeholder": "advanced-settings",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "buttonTextSep": {
            "label": "Button text",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "separator"
        },
        "buttonPrevText": {
            "label": "Previous",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "buttonNextText": {
            "label": "Next",
            "valueSchema": {
                "type": "string"
