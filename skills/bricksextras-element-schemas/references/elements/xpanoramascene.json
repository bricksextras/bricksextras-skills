{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "bricksextras://elements/xpanoramascene",
    "schemaVersion": "1.7.3",
    "type": "object",
    "title": "Panorama Scene",
    "description": "Schema for BricksExtras Panorama Scene element. A nestable element",
    "metadata": {
        "name": "xpanoramascene",
        "category": "extras",
        "tag": "div",
        "nestable": true
    },
    "settings": {
        "sceneId": {
            "label": "Scene identifier",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "sceneTitle": {
            "label": "Scene title",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "panoramaImage": {
            "label": "Panorama image",
            "valueSchema": {
                "type": "object",
                "description": "Image settings",
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "url": {
                        "type": "string"
                    }
                }
            },
            "controlType": "image"
        },
        "hasLoop": {
            "label": "Query loop",
            "description": "Populate hotspots from query results or add manually below",
            "valueSchema": {
                "type": "boolean"
            },
            "controlType": "checkbox"
        },
        "query": {
            "label": "Query",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "query"
        },
        "hotSpots": {
            "required": [
                "hasLoop",
                "=",
                ""
            ],
            "default": [],
            "placeholder": "Hotspots",
            "valueSchema": {
                "type": "array",
                "description": "Repeater items",
                "items": {
                    "type": "object"
                }
            },
            "controlType": "repeater",
            "fields": {
                "pitch": {
                    "label": "Pitch",
                    "description": "Position (\u00b0) (Vertical)",
                    "valueSchema": {
                        "oneOf": [
                            {
                                "type": "string",
                                "description": "Value with unit (e.g., \"10px\", \"50%\")"
                            },
                            {
                                "type": "number"
                            }
                        ]
                    },
                    "controlType": "number"
                },
                "yaw": {
                    "label": "Yaw",
                    "description": "Position (\u00b0) (Horizontal)",
                    "valueSchema": {
                        "oneOf": [
                            {
                                "type": "string",
                                "description": "Value with unit (e.g., \"10px\", \"50%\")"
                            },
                            {
                                "type": "number"
                            }
                        ]
                    },
                    "controlType": "number"
                },
                "icon": {
                    "label": "Icon",
                    "valueSchema": {
                        "type": "object",
                        "description": "Icon settings",
                        "properties": {
                            "library": {
                                "type": "string"
                            },
                            "icon": {
                                "type": "string"
                            },
                            "svg": {
                                "type": "object"
                            }
                        }
                    },
                    "controlType": "icon"
                },
                "text": {
                    "label": "Content (Tooltip)",
                    "valueSchema": {
                        "type": "string"
                    },
                    "controlType": "editor"
                },
                "buttonText": {
                    "label": "Button text",
                    "valueSchema": {
                        "type": "string"
                    },
                    "controlType": "text"
                },
                "hotspotName": {
                    "label": "Hotspot name",
                    "description": "Unique name to link to this hotspot from tooltip content using #hotspot-name",
                    "valueSchema": {
                        "type": "string"
                    },
                    "controlType": "text"
                },
                "hotspotAriaLabel": {
                    "label": "Aria label",
                    "valueSchema": {
                        "type": "string"
                    },
                    "controlType": "text"
                },
                "type": {
                    "label": "Type",
                    "placeholder": "Info (Default)",
                    "options": {
                        "info": "Info (Default)",
                        "scene": "Scene link",
                        "link": "Link"
                    },
                    "valueSchema": {
                        "type": "string",
                        "enum": [
                            "info",
                            "scene",
                            "link"
                        ]
                    },
                    "controlType": "select"
                },
                "link": {
                    "label": "Link",
                    "required": [
                        "type",
                        "=",
                        "link"
                    ],
                    "valueSchema": {
                        "type": "object",
                        "description": "Link settings",
                        "properties": {
                            "type": {
                                "type": "string"
                            },
                            "url": {
                                "type": "string"
                            },
                            "postId": {
                                "type": [
                                    "string",
                                    "integer"
                                ]
                            },
                            "newTab": {
                                "type": "boolean"
                            },
                            "rel": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            },
                            "ariaLabel": {
                                "type": "string"
                            },
                            "lightboxId": {
                                "type": "string"
                            },
                            "lightboxType": {
                                "type": "string"
                            }
                        }
                    },
                    "controlType": "link"
                },
                "sceneId": {
                    "label": "Scene identifier",
                    "required": [
                        "type",
                        "=",
                        "scene"
                    ],
                    "placeholder": "scene-1",
                    "valueSchema": {
                        "type": "string"
                    },
                    "controlType": "text"
                }
            }
        },
        "queryLoopSeparator": {
            "label": "Hotspots",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "separator"
        },
        "hotspotPitch": {
            "label": "Pitch",
            "description": "Position (\u00b0) (Vertical)",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "hotspotYaw": {
            "label": "Yaw",
            "description": "Position (\u00b0) (Horizontal)",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "icon": {
            "label": "Icon",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "object",
                "description": "Icon settings",
                "properties": {
                    "library": {
                        "type": "string"
                    },
                    "icon": {
                        "type": "string"
                    },
                    "svg": {
                        "type": "object"
                    }
                }
            },
            "controlType": "icon"
        },
        "hotspotText": {
            "label": "Content (Tooltip)",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "editor"
        },
        "buttonText": {
            "label": "Button text",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "hotspotType": {
            "label": "Type",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "placeholder": "info",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "hotspotLink": {
            "label": "Link URL  (used when type is &quot;link&quot;)",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "hotspotSceneId": {
            "label": "Scene identifier",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "hotspotName": {
            "label": "Hotspot name",
            "description": "Unique name to link to this hotspot from tooltip content using #hotspot-name",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "hotspotAriaLabel": {
            "label": "Aria label",
            "required": [
                "hasLoop",
                "!=",
                ""
            ],
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "viewerSceneSettingsSeparator": {
            "label": "Scene Configuration",
            "description": "Initial conditions when user arrives at this scene. Leave black to use global settings.",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "separator"
        },
        "pitch": {
            "label": "Pitch (Initial)",
            "description": "Vertical (\u00b0)",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "yaw": {
            "label": "Yaw (Initial)",
            "description": "Horizontal (\u00b0)",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "hfov": {
            "label": "Field of view",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        },
        "autoRotate": {
            "label": "Auto rotate speed",
            "description": "Rotation speed in degrees per second (0 = disabled)",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "text"
        }
    },
    "controlGroups": {
        "hotspots": {
            "title": "Hotspots",
            "tab": "content"
        },
        "viewer": {
            "title": "Viewer Settings",
            "tab": "content"
        }
    },
    "rendering": {
        "description": "HTML structure and CSS classes used by this element",
        "rootElement": "div",
        "nestable": true,
        "childrenContainer": "Renders child elements within the structure"
    },
    "documentation": {
        "description": "* Panorama Scene element class.",
        "keywords": [
            "panorama",
            "image",
            "scene"
        ],
        "usage": {
            "category": "extras",
            "nestable": true
        },
        "bestPractices": [
            "This is a nestable element - add child elements to build your content structure"
        ]
    }
}