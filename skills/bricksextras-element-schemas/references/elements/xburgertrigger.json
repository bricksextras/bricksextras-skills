{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "bricksextras://elements/xburgertrigger",
    "schemaVersion": "1.7.3",
    "type": "object",
    "title": "Burger Trigger",
    "description": "Schema for BricksExtras Burger Trigger element",
    "metadata": {
        "name": "xburgertrigger",
        "category": "extras",
        "tag": "div",
        "nestable": false
    },
    "settings": {
        "burger_animation": {
            "label": "Animation",
            "default": "x-hamburger--slider",
            "placeholder": "Slider",
            "options": {
                "x-hamburger--3dx": "3dx",
                "x-hamburger--3dy": "3dy",
                "x-hamburger--arrow": "arrow",
                "x-hamburger--arrowalt": "arrow-alt",
                "x-hamburger--arrowturn": "arrowturn",
                "x-hamburger--boring": "boring",
                "x-hamburger--collapse": "collapse",
                "x-hamburger--elastic": "elastic",
                "x-hamburger--minus": "minus",
                "x-hamburger--slider": "slider",
                "x-hamburger--squeeze": "squeeze",
                "x-hamburger--vortex": "vortex",
                "x-hamburger--none": "None"
            },
            "valueSchema": {
                "type": "string",
                "enum": [
                    "x-hamburger--3dx",
                    "x-hamburger--3dy",
                    "x-hamburger--arrow",
                    "x-hamburger--arrowalt",
                    "x-hamburger--arrowturn",
                    "x-hamburger--boring",
                    "x-hamburger--collapse",
                    "x-hamburger--elastic",
                    "x-hamburger--minus",
                    "x-hamburger--slider",
                    "x-hamburger--squeeze",
                    "x-hamburger--vortex",
                    "x-hamburger--none"
                ]
            },
            "controlType": "select"
        },
        "burger_scale": {
            "label": "Scale",
            "css": [
                {
                    "property": "--x-burger-size",
                    "selector": ".x-hamburger-box"
                }
            ],
            "placeholder": "0.8",
            "valueSchema": {
                "oneOf": [
                    {
                        "type": "string",
                        "description": "Value with unit (e.g., \"10px\", \"50%\")"
                    },
                    {
                        "type": "number"
                    }
                ]
            },
            "controlType": "number"
        },
        "burger_line_height": {
            "label": "Line height",
            "css": [
                {
                    "property": "--x-burger-line-height",
                    "selector": ".x-hamburger-box"
                }
            ],
            "placeholder": "4px",
            "valueSchema": {
                "oneOf": [
                    {
                        "type": "string",
