{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "bricksextras://elements/xcontentswitcher",
    "schemaVersion": "1.7.3",
    "type": "object",
    "title": "Content Switcher",
    "description": "Schema for BricksExtras Content Switcher element. A nestable element",
    "metadata": {
        "name": "xcontentswitcher",
        "category": "extras",
        "tag": "div",
        "nestable": true,
        "childElement": "block"
    },
    "settings": {
        "builderHidden": {
            "label": "Show only first child element in builder",
            "valueSchema": {
                "type": "boolean"
            },
            "controlType": "checkbox"
        },
        "startSep": {
            "label": "Content",
            "description": "The child elements placed inside this switcher can be toggled using the toggle switch element",
            "valueSchema": {
                "type": "string"
            },
            "controlType": "separator"
        },
        "childrenBlocks": {
            "valueSchema": {
                "type": "array",
                "description": "Repeater items",
                "items": {
                    "type": "object"
                }
            },
            "controlType": "repeater"
        },
        "transitionSep": {
            "valueSchema": {
                "type": "string"
            },
            "controlType": "separator"
        },
        "transitionDuration": {
            "label": "Duration",
            "css": [
                {
                    "selector": ".x-content-switcher_content > *",
                    "property": "transition-duration"
                }
            ],
            "placeholder": "0ms",
            "valueSchema": {
                "oneOf": [
                    {
                        "type": "string",
                        "description": "Value with unit (e.g., \"10px\", \"50%\")"
                    },
                    {
                        "type": "number"
                    }
                ]
            },
            "controlType": "number"
        }
    },
    "rendering": {
        "description": "HTML structure and CSS classes used by this element",
        "cssClasses": [
            "x-content-switcher_content"
        ],
        "rootElement": "div",
        "nestable": true,
        "childrenContainer": "Renders child elements within the structure"
    },
    "documentation": {
        "description": "* Content Switcher element class.",
        "keywords": [
            "content switcher",
            "switcher"
        ],
        "usage": {
            "category": "extras",
            "nestable": true
        },
        "bestPractices": [
            "This is a nestable element - add child elements to build your content structure"
        ]
    }
}